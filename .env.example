POSTGRES_DB=corexion
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Private CMS path (no leading slash). Set a unique value locally. Do not publish it.
DJANGO_ADMIN_PATH=cms

# Required on Vercel
# DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# CSRF_TRUSTED_ORIGINS=https://example.com
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# BLOB_READ_WRITE_TOKEN=
# NUM_PROXIES=1

# API rate limits (requests per period, e.g. 120/min, 5000/day)
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
THROTTLE_SECTIONS=120/min

# Shared cache for throttle counters when running more than one worker
# CACHE_URL=redis://127.0.0.1:6379/1
