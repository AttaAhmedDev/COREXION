POSTGRES_DB=corexion
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
# Private CMS path (no leading slash). Set a unique value locally. Do not publish it.
DJANGO_ADMIN_PATH=cms

# Required in production (DJANGO_DEBUG=0)
# DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com

# API rate limits (requests per period, e.g. 120/min, 5000/day)
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
THROTTLE_SECTIONS=120/min

# Number of reverse proxies in front of the app (0 = none)
NUM_PROXIES=0

# Shared cache for throttle counters when running multiple workers
# CACHE_URL=redis://127.0.0.1:6379/1
